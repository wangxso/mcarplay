root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# ktlint（经 Spotless 调用）读取以下配置
[*.{kt,kts}]
ktlint_code_style = ktlint_official
max_line_length = 140
# 本库惯用「KDoc 摘要 + 段落注释（分区说明）」风格，该规则与之冲突且不可自动修复
ktlint_standard_no-consecutive-comments = disabled
# 保持显式导入，不折叠为通配导入
ij_kotlin_name_count_to_use_star_import = 2147483647
ij_kotlin_name_count_to_use_star_import_with_prefix = 2147483647
