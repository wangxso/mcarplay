<?xml version="1.0" encoding="utf-8"?>
<!-- CarPlay 侧栏（左侧竖条）：顶部时间+电量，中部运行中应用，底部回桌面。
     尺寸用 dp：数值 = 设计原型 px ÷ 2.625（设计基准 1160×540@420dpi——
     dock 48dp=126px、时钟 22px，见 design/launcher-proto.html）。dock 虚拟屏
     密度由 SessionController 按画布短边等比下发（VirtualLauncher.DOCK_WIDTH_DP
     注释）：高分辨率车机上随密度等比放大，占比与奥迪基准一致。
     字号不在 XML 里写死：DockActivity 按「设计 px × designScale」以 PX 设置
     （不用 sp——dock 是像素级设计画布，不跟随手机字体缩放）。
     壁纸：DockActivity 在代码里往 dockWallpaper 塞「全流画布切片」（与桌面
     同源同路径，交界连续）；scrim 20% 黑压住壁纸保证内容可读。
     窗口必须不透明——半透明窗口下系统会往这块虚拟屏合成手机自身壁纸
     （曾导致 dock 显示手机壁纸、与桌面壁纸错位的根因）。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <ImageView
        android:id="@+id/dockWallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <View
        android:id="@+id/dockScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingLeft="3.05dp"
        android:paddingRight="3.05dp"
        android:paddingTop="4.57dp"
        android:paddingBottom="4.57dp">

    <TextView
        android:id="@+id/dockClock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="1"
        android:letterSpacing="0.03"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:includeFontPadding="false" />

    <TextView
        android:id="@+id/dockBatteryText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2.29dp"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="#B0B0B8"
        android:includeFontPadding="false" />

    <FrameLayout
        android:id="@+id/dockBatteryBar"
        android:layout_width="17.52dp"
        android:layout_height="1.52dp"
        android:layout_marginTop="1.90dp"
        android:background="#3A3A3C">

        <View
            android:id="@+id/dockBatteryFill"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="#34C759" />
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/dockApps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal" />
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.38dp"
        android:layout_marginBottom="1.52dp"
        android:background="#3A3A3C" />

    <ImageView
        android:id="@+id/dockHome"
        android:layout_width="match_parent"
        android:layout_height="41.90dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="回到桌面"
        android:padding="9.90dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_dock_home" />
    </LinearLayout>
</FrameLayout>
