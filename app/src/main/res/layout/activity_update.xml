<?xml version="1.0" encoding="utf-8"?>
<!-- 检查更新：与主界面同一套深色卡片（bg_card + M3 令牌），顶部返回箭头代替底部「返回」按钮。 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/m3_surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/updateBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_ripple_circle"
                android:contentDescription="@string/update_back"
                android:padding="8dp"
                android:src="@drawable/ic_chev_left" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/update_title"
                android:textColor="@color/m3_on_surface"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_icon_tile">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_refresh" />
                </FrameLayout>

                <TextView
                    android:id="@+id/updateCurrent"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/m3_on_var"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/updateStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textColor="@color/m3_primary"
                android:textSize="14.5sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/updateProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:indeterminateTint="@color/m3_primary"
                android:max="100"
                android:progressTint="@color/m3_primary"
                android:visibility="gone" />

            <Button
                android:id="@+id/updateCheck"
                style="@style/Widget.Mcarplay.UpdateButton"
                android:layout_marginTop="14dp"
                android:text="@string/update_check" />

            <Button
                android:id="@+id/updateDownload"
                style="@style/Widget.Mcarplay.UpdateButton.Primary"
                android:enabled="false"
                android:text="@string/update_download" />

            <Button
                android:id="@+id/updateInstall"
                style="@style/Widget.Mcarplay.UpdateButton.Primary"
                android:enabled="false"
                android:text="@string/update_install" />

            <Button
                android:id="@+id/updateCancel"
                style="@style/Widget.Mcarplay.UpdateButton"
                android:text="@string/update_cancel"
                android:visibility="gone" />

            <Button
                android:id="@+id/updateBrowser"
                style="@style/Widget.Mcarplay.UpdateButton"
                android:text="@string/update_releases" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <CheckBox
                android:id="@+id/updatePreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:button="@drawable/bg_checkbox"
                android:minHeight="44dp"
                android:paddingStart="12dp"
                android:text="@string/update_preview"
                android:textColor="@color/m3_on_surface"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/update_safety"
                android:textColor="@color/m3_on_var"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/updateNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:lineSpacingExtra="3dp"
            android:padding="16dp"
            android:textColor="@color/m3_on_surface"
            android:textIsSelectable="true"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
