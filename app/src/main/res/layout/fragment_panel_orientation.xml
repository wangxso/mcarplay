<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="20dp"
    android:paddingRight="13dp"
    android:paddingTop="14dp"
    android:paddingBottom="10dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="11dp"
        android:text="开启后竖屏应用在车机屏以横屏全屏渲染。开关本身持久保存，下次连接自动生效；系统覆盖仅在会话期间生效，会话结束自动复原，应用回到正常方向，无需手动处理。注意：部分界面文字可能变大或变小。切换开关时系统会立即重启目标应用使其生效（正在运行的应用会丢失未保存的界面状态）。"
        android:textColor="#FF8E8E93"
        android:textSize="12sp" />

    <!-- 能力不可用横幅：本机 ROM 未注册这两个 ChangeId（OEM 定制项）时显示，
         同时整列置灰。否则用户会反复点开关、只得到失败提示（红米 Android 13 实测） -->
    <TextView
        android:id="@+id/oriUnsupportedBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:background="#33E8C072"
        android:paddingLeft="10dp"
        android:paddingTop="8dp"
        android:paddingRight="10dp"
        android:paddingBottom="8dp"
        android:textColor="#FFE8C072"
        android:textSize="11.5sp"
        android:visibility="gone" />

    <!-- 面板外残留：系统侧开着覆盖、但应用已卸载（偏好随卸载消失）——列表里点不到，
         只能在顶部汇总清理。默认隐藏，有此类残留时出现 -->
    <TextView
        android:id="@+id/oriOrphanBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:background="#33FF6B6B"
        android:paddingLeft="10dp"
        android:paddingTop="8dp"
        android:paddingRight="10dp"
        android:paddingBottom="8dp"
        android:textColor="#FFFF6B6B"
        android:textSize="11.5sp"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/listLoading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="正在读取应用列表…"
            android:textColor="#7C8B8B"
            android:textSize="12.5sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/oriList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingRight="26dp"
            android:scrollbars="vertical" />

        <LinearLayout
            android:id="@+id/oriListIndex"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="right|center_vertical"
            android:orientation="vertical"
            android:paddingLeft="6dp" />
    </FrameLayout>
</LinearLayout>
