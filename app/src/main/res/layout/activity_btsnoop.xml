<?xml version="1.0" encoding="utf-8"?>
<!-- 蓝牙抓包分析：与检查更新同一套深色卡片；结果只在本机解析、已脱敏。 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/m3_surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btsnoopBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_ripple_circle"
                android:contentDescription="@string/update_back"
                android:padding="8dp"
                android:src="@drawable/ic_chev_left"
                app:tint="@color/ui_text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/btsnoop_title"
                android:textColor="@color/m3_on_surface"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="3dp"
                android:text="@string/btsnoop_steps"
                android:textColor="@color/m3_on_surface"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btsnoopDeveloper"
                style="@style/Widget.Mcarplay.UpdateButton"
                android:layout_marginTop="14dp"
                android:text="@string/btsnoop_open_developer" />

            <Button
                android:id="@+id/btsnoopPick"
                style="@style/Widget.Mcarplay.UpdateButton.Primary"
                android:text="@string/btsnoop_pick" />

            <TextView
                android:id="@+id/btsnoopStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/btsnoop_idle"
                android:textColor="@color/m3_primary"
                android:textSize="14.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/btsnoop_privacy"
                android:textColor="@color/m3_on_var"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btsnoopResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:fontFamily="monospace"
            android:lineSpacingExtra="2dp"
            android:padding="16dp"
            android:textColor="@color/m3_on_surface"
            android:textIsSelectable="true"
            android:textSize="11.5sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btsnoopCopy"
            style="@style/Widget.Mcarplay.UpdateButton"
            android:layout_marginTop="12dp"
            android:text="@string/btsnoop_copy"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
