<?xml version="1.0" encoding="utf-8"?>
<!-- 免责声明弹窗：标题固定 → 正文可滚动 → 底部按钮固定。
     视觉与「选择目标车机」弹窗一致（bg_dialog_panel / M3 深色令牌 / 胶囊按钮）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_panel"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="18dp"
    android:paddingEnd="18dp"
    android:paddingBottom="14dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="免责声明"
        android:textColor="@color/m3_on_surface"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/disclaimerSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="首次使用前请完整阅读。接受后可在主界面底部随时重看。"
        android:textColor="@color/m3_on_var"
        android:textSize="11.5sp" />

    <!-- 正文：高度受限（屏高约 60%），必须滚动才能看完 -->
    <ScrollView
        android:id="@+id/disclaimerScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:fadeScrollbars="false"
        android:scrollbars="vertical">

        <LinearLayout
            android:id="@+id/disclaimerSections"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingEnd="4dp" />
    </ScrollView>

    <!-- 阻止接受的原因（倒计时 / 未滑到底）；可接受时隐藏 -->
    <TextView
        android:id="@+id/disclaimerBlockHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="@color/m3_amber"
        android:textSize="11.5sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <!-- 放弃使用：不受倒计时/滚动约束（拒绝不应被阻拦） -->
        <TextView
            android:id="@+id/btnDecline"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_tbtn"
            android:gravity="center"
            android:text="放弃使用"
            android:textColor="@color/m3_on_var"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnAccept"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1.4"
            android:background="@drawable/bg_cta_fill"
            android:enabled="false"
            android:gravity="center"
            android:textColor="@color/disclaimer_accept_text"
            android:textSize="13.5sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
