<?xml version="1.0" encoding="utf-8"?>
<!-- 选择目标车机弹窗里的单个设备行：图标块 + 名称/地址 + 右侧状态胶囊 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_bt_device_row"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="9dp"
    android:paddingEnd="12dp"
    android:paddingBottom="9dp">

    <FrameLayout
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@drawable/bg_icon_tile">

        <ImageView
            android:id="@+id/devIcon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:contentDescription="蓝牙设备"
            android:src="@drawable/ic_bluetooth" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/devName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/m3_on_surface"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/devAddr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/m3_mono_dim"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/devAction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_tbtn"
        android:gravity="center"
        android:paddingStart="11dp"
        android:paddingTop="4dp"
        android:paddingEnd="11dp"
        android:paddingBottom="4dp"
        android:text="选择"
        android:textColor="@color/m3_primary"
        android:textSize="11.5sp"
        android:textStyle="bold" />
</LinearLayout>
