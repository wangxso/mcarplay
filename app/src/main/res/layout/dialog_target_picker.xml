<?xml version="1.0" encoding="utf-8"?>
<!-- 「选择目标车机」弹窗：深色面板 + 两组列表（已配对 / 扫描到的设备），
     视觉与主界面一致（M3 深色令牌、24dp 圆角、胶囊按钮） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_panel"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="18dp"
    android:paddingEnd="18dp"
    android:paddingBottom="14dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/lay_pick_target"
        android:textColor="@color/m3_on_surface"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/lay_pick_target_desc"
        android:textColor="@color/m3_on_var"
        android:textSize="11.5sp" />

    <ScrollView
        android:id="@+id/pickerScroll"
        android:layout_width="match_parent"
        android:layout_height="500dp"
        android:layout_marginTop="10dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 模式行：不属于任何一组（auto=不指定目标） -->
            <LinearLayout
                android:id="@+id/autoRowContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- ============ 组 1：已配对 ============ -->
            <TextView
                android:id="@+id/sectionBonded"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="4dp"
                android:paddingTop="4dp"
                android:paddingEnd="4dp"
                android:paddingBottom="7dp"
                android:text="@string/lay_paired"
                android:textColor="@color/m3_mono_key"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/bondedList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/bondedEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="4dp"
                android:paddingTop="2dp"
                android:paddingEnd="4dp"
                android:paddingBottom="8dp"
                android:text="@string/lay_no_paired"
                android:textColor="@color/m3_mono_dim"
                android:textSize="11.5sp"
                android:visibility="gone" />

            <!-- ============ 组 2：扫描到的设备 ============ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="4dp"
                    android:text="@string/lay_nearby"
                    android:textColor="@color/m3_mono_key"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnRescan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_tbtn"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="3dp"
                    android:text="@string/lay_rescan"
                    android:textColor="@color/m3_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/scanStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="4dp"
                android:paddingTop="6dp"
                android:paddingEnd="4dp"
                android:paddingBottom="4dp"
                android:text="@string/ma_scanning"
                android:textColor="@color/m3_mono_dim"
                android:textSize="11.5sp" />

            <LinearLayout
                android:id="@+id/scannedList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/btnCancelPicker"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_tbtn"
        android:gravity="center"
        android:text="@string/action_cancel"
        android:textColor="@color/m3_on_var"
        android:textSize="13.5sp"
        android:textStyle="bold" />
</LinearLayout>
