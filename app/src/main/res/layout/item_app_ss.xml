<?xml version="1.0" encoding="utf-8"?>
<!-- 应用超采样设置行：图标 + 名称 + 三态分段控件（自动/开启/关闭） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="4dp"
    android:layout_marginRight="4dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_app_row"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="8dp"
    android:paddingTop="7dp"
    android:paddingRight="8dp"
    android:paddingBottom="7dp">

    <ImageView
        android:id="@+id/ssIcon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/ssName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#FFF5F5F7"
        android:textSize="13sp" />

    <!-- 三态分段控件：自动 / 开启 / 关闭 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_segment"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/ssAuto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_segment_sel"
            android:paddingLeft="11dp"
            android:paddingTop="5dp"
            android:paddingRight="11dp"
            android:paddingBottom="5dp"
            android:text="自动"
            android:textColor="#FFF5F5F7"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/ssOn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="11dp"
            android:paddingTop="5dp"
            android:paddingRight="11dp"
            android:paddingBottom="5dp"
            android:text="开启"
            android:textColor="#FF8E8E93"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/ssOff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="11dp"
            android:paddingTop="5dp"
            android:paddingRight="11dp"
            android:paddingBottom="5dp"
            android:text="关闭"
            android:textColor="#FF8E8E93"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
