<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 字体：系统无衬线（SF Pro 受授权限制不随包），半粗加轻微负字距 -->
    <style name="TextAppearance.Ui" parent="">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/ui_text</item>
    </style>

    <style name="TextAppearance.Ui.Display">
        <item name="android:textSize">@dimen/ui_text_display</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="TextAppearance.Ui.Title">
        <item name="android:textSize">@dimen/ui_text_title</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.Ui.Body">
        <item name="android:textSize">@dimen/ui_text_body</item>
        <item name="android:textFontWeight">400</item>
    </style>

    <style name="TextAppearance.Ui.Label">
        <item name="android:textSize">@dimen/ui_text_label</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:textColor">@color/ui_text_secondary</item>
    </style>

    <style name="TextAppearance.Ui.Caption">
        <item name="android:textSize">@dimen/ui_text_caption</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:textColor">@color/ui_text_secondary</item>
    </style>

    <!-- 按钮：胶囊、≥48dp、按下缩放；主按钮蓝底白字，次按钮淡蓝底蓝字，危险按钮淡红底红字 -->
    <style name="Widget.Ui.Button" parent="">
        <item name="android:minHeight">@dimen/ui_touch_min</item>
        <item name="android:paddingStart">@dimen/ui_space_6</item>
        <item name="android:paddingEnd">@dimen/ui_space_6</item>
        <item name="android:gravity">center</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:textSize">@dimen/ui_text_body</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@animator/ui_press_scale</item>
    </style>

    <style name="Widget.Ui.Button.Primary">
        <item name="android:background">@drawable/ui_btn_primary</item>
        <item name="android:textColor">@color/ui_btn_primary_text</item>
    </style>

    <style name="Widget.Ui.Button.Secondary">
        <item name="android:background">@drawable/ui_btn_secondary</item>
        <item name="android:textColor">@color/ui_btn_secondary_text</item>
    </style>

    <style name="Widget.Ui.Button.Danger">
        <item name="android:background">@drawable/ui_btn_danger</item>
        <item name="android:textColor">@color/ui_btn_danger_text</item>
    </style>

    <style name="Widget.Ui.Card" parent="">
        <item name="android:background">@drawable/ui_bg_card</item>
        <item name="android:elevation">@dimen/ui_card_elevation</item>
        <item name="android:padding">@dimen/ui_space_5</item>
    </style>

    <style name="Widget.Ui.Field" parent="">
        <item name="android:background">@drawable/ui_bg_field</item>
        <item name="android:minHeight">@dimen/ui_touch_min</item>
        <item name="android:paddingStart">@dimen/ui_space_4</item>
        <item name="android:paddingEnd">@dimen/ui_space_4</item>
        <item name="android:textSize">@dimen/ui_text_body</item>
        <item name="android:textColor">@color/ui_text</item>
        <item name="android:textColorHint">@color/ui_text_secondary</item>
    </style>

    <!-- 底部面板的进出：自下滑入，不回弹 -->
    <style name="Animation.Ui.BottomSheet" parent="">
        <item name="android:windowEnterAnimation">@anim/ui_sheet_in</item>
        <item name="android:windowExitAnimation">@anim/ui_sheet_out</item>
    </style>
</resources>
