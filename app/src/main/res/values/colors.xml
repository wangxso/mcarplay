<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="ic_launcher_background">#0DCC58</color>

    <!-- 手机侧旧 Material 3 令牌：现为 ui_* 令牌（见 colors_ui.xml / values-night）的别名，
         手机界面因此随系统浅/深色切换。新代码直接用 ui_*；这些别名在设置与诊断页迁完后删除。
         车机桌面不使用它们（grep m3_ 无 launcher 命中），仍是独立的深色体系。 -->
    <color name="m3_surface">@color/ui_bg</color>
    <color name="m3_surface_low">@color/ui_card</color>
    <color name="m3_surface_highest">@color/ui_track</color>
    <color name="m3_on_surface">@color/ui_text</color>
    <color name="m3_on_var">@color/ui_text_secondary</color>
    <color name="m3_outline">@color/ui_text_disabled</color>
    <color name="m3_outline_var">@color/ui_track</color>
    <color name="m3_primary">@color/ui_accent_text</color>
    <color name="m3_on_primary">@color/ui_on_accent</color>
    <color name="m3_sec_container">@color/ui_field</color>
    <color name="m3_on_sec_container">@color/ui_text</color>
    <color name="m3_error">@color/ui_error_text</color>
    <color name="m3_err_container">@color/ui_error_tint</color>
    <color name="m3_on_err_container">@color/ui_error_text</color>
    <color name="m3_inverse">@color/ui_text</color>
    <color name="m3_on_inverse">@color/ui_bg</color>
    <color name="m3_ok">@color/ui_ok_text</color>
    <color name="m3_ok_dot">@color/ui_ok</color>
    <color name="m3_amber">@color/ui_warn</color>
    <color name="m3_mono_dim">@color/ui_text_secondary</color>
    <color name="m3_mono_key">@color/ui_accent_text</color>
    <!-- 日志控制台在浅色模式下仍是终端式深底，所以这两个保持固定值 -->
    <color name="m3_console_text">#8FCFA4</color>
    <color name="m3_console_bg">#0A0F10</color>
</resources>
