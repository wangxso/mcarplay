<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools" tools:locale="zh-rCN">
    <string name="lay_display">显示</string>
    <string name="lay_disclaimer_intro">首次使用前请完整阅读。接受后可在主界面底部随时重看。</string>
    <string name="lay_decline">放弃使用</string>
    <string name="cd_back">返回</string>
    <string name="cd_bt_device">蓝牙设备</string>
    <string name="lay_display_desc">输出分辨率可选「跟随车机」（按车机分辨率百分比缩放）或固定档位/自定义宽高。固定模式忽略百分比，分辨率与帧率改动均在下次连接起效。CarWith 可能不采纳请求尺寸，实际以连接日志中的 VIDEO_INIT_DONE 为准。</string>
    <string name="lay_screen_off">连接时真息屏</string>
    <string name="lay_on">开</string>
    <string name="lay_off_short">关</string>
    <string name="lay_screen_off_desc">连接成功后物理断电手机面板（系统保持唤醒）；关闭则只用暗幕。按电源键两次可恢复屏幕。</string>
    <string name="lay_auto_connect">上车自动连接</string>
    <string name="lay_auto_connect_desc">车机蓝牙连上时自动拉起会话（需 Shizuku 已启动）。需要「显示在其他应用上层」权限才能在后台启动；该权限缺失时会自动补授。</string>
    <string name="lay_hid_raw">HID 原始日志</string>
    <string name="lay_hid_raw_desc">键位校准用：打开后每帧 HID 报文写一行 HID-RAW（uuid + hex 字节），对照按下方向盘/旋钮时打印的字节调整键位映射。平时请关闭，避免日志刷屏。</string>
    <string name="lay_plain_fallback">兼容兜底：配对失败后尝试明文</string>
    <string name="lay_plain_fallback_desc">默认关。配对失败（403 除外）但已连上接收端时，再试一次不加密的明文会话。仅当接收端始终卡在配对且确认它只支持明文时打开；下次连接起效。</string>
    <string name="lay_audio_fallback">兼容兜底：音频格式未声明时仍尝试</string>
    <string name="lay_audio_fallback_desc">默认关。接收端没有声明可用的媒体音频格式时，仍按默认 PCM 48k 尝试出声。仅当车机能播声音却总是只推视频时打开；可能出现无声或断开，下次连接起效。</string>
    <string name="lay_duck_level">导航时音乐音量</string>
    <string name="lay_duck_level_desc">导航或语音提示播报时，音乐临时压低到这个音量，播报结束后再淡回。往右拖压得更低，最左为不压低；默认 -15 dB。连接中调整立即生效。</string>
    <string name="lay_duck_level_value">%1$d dB</string>
    <string name="lay_duck_level_off">不压低</string>
    <string name="lay_stream_resolution">输出分辨率</string>
    <string name="lay_res_follow">跟随车机</string>
    <string name="lay_res_720">720p</string>
    <string name="lay_res_1080">1080p</string>
    <string name="lay_res_custom">自定义</string>
    <string name="lay_res_width">宽</string>
    <string name="lay_res_height">高</string>
    <string name="lay_res_apply">应用</string>
    <string name="lay_res_times">×</string>
    <string name="lay_res_note_follow">跟随车机：车机分辨率 × %1$d%%，按偶数对齐；实际源尺寸以 VIDEO_INIT_DONE 为准。</string>
    <string name="lay_res_note_fixed">固定 %1$d×%2$d：忽略百分比缩放，连接时直接作为流尺寸并向 CarWith 请求；CarWith 可能不采纳。</string>
    <string name="lay_res_note_custom">自定义 %1$d×%2$d：受 320×180–1920×1080 与偶数对齐约束；CarWith 可能不采纳请求。</string>
    <string name="lay_res_saved">已选 %1$s（下次连接起效）</string>
    <string name="lay_res_custom_saved">已保存自定义分辨率 %1$d×%2$d（下次连接起效）</string>
    <string name="lay_res_error_blank">请输入宽和高</string>
    <string name="lay_res_error_number">宽和高必须是正整数</string>
    <string name="lay_res_error_min">最小尺寸 320×180</string>
    <string name="lay_res_error_max">最大尺寸 1920×1080</string>
    <string name="lay_res_error_level4">该尺寸超出 H.264 level 4.0 单帧宏块上限</string>
    <string name="lay_res_fps_warning">H.264 level 4.0 下 %1$d×%2$d 最高 %3$d fps；选择 60 fps 时连接会按 %3$d fps 编码。</string>
    <string name="lay_res_clamp_warning">该尺寸超出 H.264 level 4.0 单帧上限，连接时会缩至 %1$d×%2$d。</string>
    <string name="lay_scale_disabled">固定分辨率模式下百分比缩放不生效</string>
    <string name="sf_display_running">本连接流 %1$d×%2$d · %3$d fps</string>
    <string name="lay_next_connection">保存后下次连接起效</string>
    <string name="lay_target_fps">目标帧率</string>
    <string name="lay_target_fps_desc">连接中切换下次连接起效（编码器帧率在会话建立时定型）；英雄卡显示本轮实际/目标帧率</string>
    <string name="lay_pick_target">选择目标车机</string>
    <string name="lay_pick_target_desc">已配对设备可直接选用；点击未配对的设备会发起系统蓝牙配对</string>
    <string name="lay_paired">已配对</string>
    <string name="lay_no_paired">暂无已配对设备——请在下方扫描并点击配对</string>
    <string name="lay_nearby">附近的设备</string>
    <string name="lay_rescan">重新扫描</string>
    <string name="lay_passat_return">实验：帕萨特回主界面再进 CarPlay</string>
    <string name="lay_passat_off">关闭</string>
    <string name="lay_passat_retry">失败重建</string>
    <string name="lay_passat_disconnect">失败断开</string>
    <string name="lay_passat_norebuild">不重建</string>
    <string name="lay_passat_return_desc">默认关。需先在主页「车型适配」选「大众」才会执行；每次只选一个来试。失败重建：拿回主屏 3 秒内车机无触控也无要帧时，自动重建一次主屏流。失败断开：连续两次无反应就结束本轮，请重新连接。不重建：点图标时不重建主屏流，只重申归属并补参数集。均无实车证据，下次点图标起效。</string>
    <string name="sf_passat_off">已关闭帕萨特实验策略</string>
    <string name="sf_passat_retry">已选：失败后重建一次</string>
    <string name="sf_passat_disconnect">已选：连续失败后断开</string>
    <string name="sf_passat_norebuild">已选：点图标不重建主屏流</string>
</resources>
