    <string name="ma_audio_choice_title">是否在车机侧播放声音？</string>
    <string name="ma_audio_choice_body">开启后手机媒体/导航声音投到车机播放、手机本机静音（不开启则车上无声）。\n音视频同时传会增加负载，以看视频为主时可先不开启。\n</string>
    <string name="ma_audio_choice_carwith">使用 CarWith 原生声音，无需额外录屏授权。</string>
    <string name="ma_audio_choice_projection">开启声音需要「投屏」权限，会一并申请。</string>
    <string name="ma_cancel_connect_title">取消连接？</string>
    <string name="ma_cancel_connect_body">将停止当前连接尝试：蓝牙与 WiFi 链路都会断开，需重新点「启动连接」。</string>
    <string name="ma_keep_connecting">继续连接</string>
    <string name="ma_cancel_connect">取消连接</string>
    <string name="ma_carwith_missing_title">CarWith 组件未就绪</string>
    <string name="ma_carwith_missing_body">当前桥接需要小米 CarWith 与小米 CarLife 组件。请先检查系统车联设置；此提示不代表所有 Android 手机均可使用。</string>
    <string name="ma_export_report">导出诊断报告</string>
    <string name="ma_bt_off_title">蓝牙未开启</string>
    <string name="ma_bt_off_body">与车机的无线配对通信依赖蓝牙。请先开启手机蓝牙，并确认已与车机配对。</string>
    <string name="ma_bt_open_settings">去开启蓝牙</string>
    <string name="ma_location_title">需要开启位置服务</string>
    <string name="ma_location_body">Android 12 加入车机热点（应用专属 WiFi）要求位置服务开启——系统用它判定可连接的 WiFi，不会记录你的位置。\n\n请打开位置服务后重试；也可以到WLAN 设置手动连接热点。</string>
    <string name="ma_turn_on">去开启</string>
    <string name="ma_hu_permissions">亿连发现诊断需要蓝牙、Wi-Fi Direct 与通知权限</string>
    <string name="ma_disconnect_title">断开连接？</string>
    <string name="ma_disconnect_body">将停止车机推流并关闭保活服务，车机画面会立即中断。</string>
    <string name="ma_disconnect_projection_note">\n\n注意：投屏授权会随服务停止失效，下次如需车机侧声音请重新授权。</string>
