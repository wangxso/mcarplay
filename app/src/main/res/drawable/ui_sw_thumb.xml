<?xml version="1.0" encoding="utf-8"?>
<!-- 开关滑块：27dp 白色圆，外留 2dp 与轨道边缘的间距，细描边让它在白卡片上仍可辨 -->
<inset xmlns:android="http://schemas.android.com/apk/res/android" android:inset="2dp">
    <shape android:shape="oval">
        <solid android:color="#FFFFFF" />
        <stroke android:width="0.5dp" android:color="#29000000" />
        <size android:width="27dp" android:height="27dp" />
    </shape>
</inset>
