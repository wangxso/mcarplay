<?xml version="1.0" encoding="utf-8"?>
<!-- remote 变体叠加：远程调试桥专属权限与组件。只在 remote 变体合并，日常/发布包无此文件。 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 重装闭环：PackageInstaller 发起安装（系统仍会弹确认） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".bridge.BridgeApp"
        android:usesCleartextTraffic="true"
        tools:replace="android:name,android:usesCleartextTraffic">
        <activity
            android:name=".bridge.UsbMediaBenchActivity"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:theme="@style/Theme.CarPlaySender" />
        <activity
            android:name=".bridge.UsbWiredConnectActivity"
            android:exported="false"
            android:theme="@style/Theme.CarPlaySender" />
        <!-- usesCleartextTraffic：调试桥按部署可能是纯 HTTP（如 frp+VPS 的
             http://IP:8787），API 28+ 默认禁明文会让 APK 下载直接失败
             （2026-10-21 实测 Cleartext HTTP traffic not permitted）。
             只放开调试包；发布包不受影响。 -->

        <!-- 调试版唯一桌面入口「mcarplay 远程调试」：填地址/配对码，页内有「打开主界面」。
             singleTop：安装确认/续接询问带参重入时走 onNewIntent，不叠加实例 -->
        <activity
            android:name=".bridge.BridgeSetupActivity"
            android:exported="true"
            android:label="mcarplay 远程调试"
            android:launchMode="singleTop"
            android:theme="@style/Theme.CarPlaySender">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 摘掉调试版主界面的桌面图标（保留 Activity 本身：设置页/桥命令仍要打开它），
             否则调试版出现两个入口、桌面三个 mcarplay，用户分不清 -->
        <activity
            android:name="com.mcarplay.app.MainActivity"
            android:exported="true"
            tools:node="merge">
            <intent-filter tools:node="remove">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- PackageInstaller 状态回收：**必须声明 intent-filter**——自定义 action
             没有过滤器时广播永远投递不到本接收器，安装确认（PENDING_USER_ACTION）
             无人拉起、闭环断在第一环（2026-10-21 实测「点了没效果」根因）；
             exported=false + setPackage 已限定只有本包/持 PendingIntent 者可发 -->
        <receiver
            android:name=".bridge.InstallReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.mcarplay.app.BRIDGE_INSTALL_RESULT" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
